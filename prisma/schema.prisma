generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum StaffRole {
  HEAD_OFFICE_TEAM_LEADER
  AREA_TEAM_LEADER
  BRANCH_TEAM_LEADER
  CASHIER
  BOOKKEEPER
  ACCOUNT_OFFICER
}

enum UserRole {
  SUPER_ADMIN
  HEAD_OFFICE_ADMIN
  ACCOUNT_ASSISTANT
  HEAD_OFFICE_CREDIT_COMMITTEE
  AREA_TEAM_LEADER
  BRANCH_TEAM_LEADER
  ACCOUNT_OFFICER
  CASHIER
  BOOKKEEPER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum LoanStatus {
  DRAFT
  CI_BI_IN_PROGRESS
  FOR_SCORECARD
  AUTO_DENIED
  FOR_ENDORSEMENT
  ENDORSED
  FOR_CREDIT_COMMITTEE
  PROCEED
  APPROVED
  DENIED
  CANCELLED
}

enum ScorecardResult {
  AUTO_DENIED
  DENIED
  FOR_ENDORSEMENT
  FOR_CREDIT_COMMITTEE
  PROCEED
}

enum NaTreatment {
  NEVER_NA
  EXCLUDE_RENORMALIZE
  ASSIGN_NEUTRAL_2
  ASSIGN_FIXED_1
  ASSIGN_FIXED_2
  ASSIGN_FIXED_4
}

enum CommitteeStatus {
  ACTIVE
  INACTIVE
}

enum CommitteeDecision {
  PENDING
  APPROVED
  DENIED
  RETURNED_FOR_COMPLETION
}

model Branch {
  id                   Int                         @id @default(autoincrement())
  branchCode           String                      @unique @map("branch_code") @db.VarChar(20)
  branchName           String                      @map("branch_name") @db.VarChar(120)
  branchAddress        String?                     @map("branch_address") @db.VarChar(255)
  isHeadOffice         Boolean                     @default(false) @map("is_head_office")
  status               BranchStatus                @default(ACTIVE)
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  users                User[]
  assignments          BranchStaffAssignment[]
  loanApplications     LoanApplication[]
  creditCommittees     CreditCommittee[]
  committeeAssignments BranchCommitteeAssignment[]

  @@map("branches")
}

model BranchStaffAssignment {
  id         Int       @id @default(autoincrement())
  branchId   Int       @map("branch_id")
  userId     Int       @map("user_id")
  staffRole  StaffRole @map("staff_role")
  activeFrom DateTime  @default(now()) @map("active_from")
  activeTo   DateTime? @map("active_to")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  branch     Branch    @relation(fields: [branchId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([userId])
  @@map("branch_staff_assignments")
}

model User {
  id                         Int                         @id @default(autoincrement())
  employeeNo                 String                      @unique @map("employee_no") @db.VarChar(50)
  fullName                   String                      @map("full_name") @db.VarChar(160)
  email                      String                      @unique @db.VarChar(160)
  username                   String                      @unique @db.VarChar(80)
  passwordHash               String                      @map("password_hash") @db.VarChar(255)
  branchId                   Int                         @map("branch_id")
  role                       UserRole
  positionId                 Int?                        @map("position_id")
  status                     UserStatus                  @default(ACTIVE)
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  branch                     Branch                      @relation(fields: [branchId], references: [id])
  position                   Position?                   @relation(fields: [positionId], references: [id])
  assignments                BranchStaffAssignment[]
  loanApplications           LoanApplication[]           @relation("LoanOfficer")
  createdApplications        LoanApplication[]           @relation("ApplicationCreator")
  scoredScorecards           CreditScorecard[]           @relation("ScorecardScorer")
  committeeMemberships       CreditCommitteeMember[]
  committeeReviews           CreditCommitteeReview[]
  branchCommitteeAssignments BranchCommitteeAssignment[]
  endorsedApplications       LoanApplication[]           @relation("LoanEndorser")
  returnedApplications       LoanApplication[]           @relation("LoanReturner")
  auditLogs                  AuditLog[]

  @@index([branchId])
  @@index([positionId])
  @@map("users")
}

model Position {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(120)
  systemRole UserRole @map("system_role")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  users      User[]

  @@map("positions")
}

model LoanApplication {
  id                   Int                     @id @default(autoincrement())
  applicationNo        String                  @unique @map("application_no") @db.VarChar(40)
  ciFormNo             String?                 @unique @map("ci_form_no") @db.VarChar(40)
  dateOfCi             DateTime?               @map("date_of_ci")
  loanOfficerId        Int                     @map("loan_officer_id")
  branchId             Int                     @map("branch_id")
  branchCode           String                  @map("branch_code") @db.VarChar(20)
  loanPurpose          String?                 @map("loan_purpose") @db.Text
  loanPurposeCategory  String?                 @map("loan_purpose_category") @db.VarChar(40)
  aoClientRemarks      String?                 @map("ao_client_remarks") @db.Text
  loanProduct          String?                 @map("loan_product") @db.VarChar(120)
  amountApplied        Decimal                 @default(0) @map("amount_applied") @db.Decimal(14, 2)
  desiredTerms         String?                 @map("desired_terms") @db.VarChar(120)
  proposedAmortization Decimal?                @map("proposed_amortization") @db.Decimal(14, 2)
  status               LoanStatus              @default(DRAFT)
  endorsedBy           Int?                    @map("endorsed_by")
  endorsedAt           DateTime?               @map("endorsed_at")
  endorsementCode      String?                 @map("endorsement_code") @db.VarChar(40)
  endorsementRemarks   String?                 @map("endorsement_remarks") @db.Text
  returnedBy           Int?                    @map("returned_by")
  returnedAt           DateTime?               @map("returned_at")
  returnedFromRole     String?                 @map("returned_from_role") @db.VarChar(80)
  returnedRemarks      String?                 @map("returned_remarks") @db.Text
  createdBy            Int                     @map("created_by")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  branch               Branch                  @relation(fields: [branchId], references: [id])
  loanOfficer          User                    @relation("LoanOfficer", fields: [loanOfficerId], references: [id])
  creator              User                    @relation("ApplicationCreator", fields: [createdBy], references: [id])
  endorser             User?                   @relation("LoanEndorser", fields: [endorsedBy], references: [id])
  returner             User?                   @relation("LoanReturner", fields: [returnedBy], references: [id])
  applicantProfile     ApplicantProfile?
  householdBackground  HouseholdBackground?
  incomeProfile        IncomeProfile?
  liabilities          ExistingLiability[]
  references           CharacterReference[]
  assets               Asset[]
  collateral           Collateral[]
  businessContacts     BusinessContact[]
  cashFlows            CashFlowEntry[]
  cropProductions      CropProduction[]
  farmCostItems        FarmCostItem[]
  attachedProperties   AttachedProperty[]
  scorecard            CreditScorecard?
  committeeReviews     CreditCommitteeReview[]
  requirements         LoanRequirement[]
  sectionRemarks       LoanSectionRemark[]
  computation          LoanComputation?

  @@index([branchId])
  @@index([branchCode])
  @@index([applicationNo])
  @@index([ciFormNo])
  @@index([createdBy])
  @@index([loanOfficerId])
  @@index([status])
  @@index([dateOfCi])
  @@index([endorsedBy])
  @@map("loan_applications")
}

model ApplicantProfile {
  id                               Int             @id @default(autoincrement())
  loanApplicationId                Int             @unique @map("loan_application_id")
  fullName                         String          @map("full_name") @db.VarChar(160)
  lastName                         String?         @map("last_name") @db.VarChar(80)
  firstName                        String?         @map("first_name") @db.VarChar(80)
  middleName                       String?         @map("middle_name") @db.VarChar(80)
  nickname                         String?         @db.VarChar(80)
  placeOfBirth                     String?         @map("place_of_birth") @db.VarChar(160)
  dateOfBirth                      DateTime?       @map("date_of_birth")
  age                              Int?
  sex                              String?         @db.VarChar(30)
  civilStatus                      String?         @map("civil_status") @db.VarChar(50)
  currentAddress                   String?         @map("current_address") @db.Text
  addressRegion                    String?         @map("address_region") @db.VarChar(120)
  addressProvince                  String?         @map("address_province") @db.VarChar(120)
  addressCityMunicipality          String?         @map("address_city_municipality") @db.VarChar(120)
  addressBarangay                  String?         @map("address_barangay") @db.VarChar(160)
  addressStreet                    String?         @map("address_street") @db.VarChar(255)
  yearsAtAddress                   Decimal?        @map("years_at_address") @db.Decimal(5, 2)
  permanentSameAsCurrent           Boolean         @default(false) @map("permanent_same_as_current")
  permanentAddress                 String?         @map("permanent_address") @db.Text
  permanentAddressRegion           String?         @map("permanent_address_region") @db.VarChar(120)
  permanentAddressProvince         String?         @map("permanent_address_province") @db.VarChar(120)
  permanentAddressCityMunicipality String?         @map("permanent_address_city_municipality") @db.VarChar(120)
  permanentAddressBarangay         String?         @map("permanent_address_barangay") @db.VarChar(160)
  permanentAddressStreet           String?         @map("permanent_address_street") @db.VarChar(255)
  residenceType                    String?         @map("residence_type") @db.VarChar(80)
  monthlyRentOrMortgage            Decimal?        @map("monthly_rent_or_mortgage") @db.Decimal(14, 2)
  contactNumber                    String?         @map("contact_number") @db.VarChar(60)
  alternateContact                 String?         @map("alternate_contact") @db.VarChar(60)
  email                            String?         @db.VarChar(160)
  alternateEmail                   String?         @map("alternate_email") @db.VarChar(160)
  gcashNumber                      String?         @map("gcash_number") @db.VarChar(60)
  facebook                         String?         @db.VarChar(160)
  twitter                          String?         @db.VarChar(160)
  tiktok                           String?         @db.VarChar(160)
  instagram                        String?         @db.VarChar(160)
  tinNo                            String?         @map("tin_no") @db.VarChar(80)
  sssId                            String?         @map("sss_id") @db.VarChar(80)
  gsisId                           String?         @map("gsis_id") @db.VarChar(80)
  philhealthNo                     String?         @map("philhealth_no") @db.VarChar(80)
  pagibigNo                        String?         @map("pagibig_no") @db.VarChar(80)
  driversLicense                   String?         @map("drivers_license") @db.VarChar(80)
  photoDataUrl                     String?         @map("photo_data_url") @db.LongText
  photoMimeType                    String?         @map("photo_mime_type") @db.VarChar(40)
  createdAt                        DateTime        @default(now()) @map("created_at")
  updatedAt                        DateTime        @updatedAt @map("updated_at")
  loanApplication                  LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@index([loanApplicationId])
  @@map("applicant_profiles")
}

model HouseholdBackground {
  id                       Int             @id @default(autoincrement())
  loanApplicationId        Int             @unique @map("loan_application_id")
  spousePartnerName        String?         @map("spouse_partner_name") @db.VarChar(160)
  spouseNickname           String?         @map("spouse_nickname") @db.VarChar(80)
  spouseCurrentAddress     String?         @map("spouse_current_address") @db.Text
  spouseYearsAtAddress     Decimal?        @map("spouse_years_at_address") @db.Decimal(5, 2)
  spouseOccupationEmployer String?         @map("spouse_occupation_employer") @db.VarChar(160)
  spouseEmployerAddress    String?         @map("spouse_employer_address") @db.Text
  spouseMonthlyIncome      Decimal?        @map("spouse_monthly_income") @db.Decimal(14, 2)
  numberOfDependents       Int?            @map("number_of_dependents")
  dependentsUnder18        Int?            @map("dependents_under_18")
  fatherName               String?         @map("father_name") @db.VarChar(160)
  fatherDob                DateTime?       @map("father_dob") @db.Date
  fatherDod                DateTime?       @map("father_dod") @db.Date
  fatherAge                Int?            @map("father_age")
  fatherOccupation         String?         @map("father_occupation") @db.VarChar(160)
  motherName               String?         @map("mother_name") @db.VarChar(160)
  motherDob                DateTime?       @map("mother_dob") @db.Date
  motherDod                DateTime?       @map("mother_dod") @db.Date
  motherAge                Int?            @map("mother_age")
  motherOccupation         String?         @map("mother_occupation") @db.VarChar(160)
  parentAddress            String?         @map("parent_address") @db.Text
  isPrimaryIncomeEarner    Boolean?        @map("is_primary_income_earner")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")
  loanApplication          LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@index([loanApplicationId])
  @@map("household_backgrounds")
}

model IncomeProfile {
  id                           Int             @id @default(autoincrement())
  loanApplicationId            Int             @unique @map("loan_application_id")
  employmentStatus             String?         @map("employment_status") @db.VarChar(160)
  employmentStatusOther        String?         @map("employment_status_other") @db.VarChar(160)
  employerName                 String?         @map("employer_name") @db.VarChar(160)
  positionDesignation          String?         @map("position_designation") @db.VarChar(120)
  employmentType               String?         @map("employment_type") @db.VarChar(80)
  companyAddress               String?         @map("company_address") @db.Text
  lengthOfService              String?         @map("length_of_service") @db.VarChar(80)
  hrSupervisorNameContact      String?         @map("hr_supervisor_name_contact") @db.VarChar(180)
  grossMonthlySalary           Decimal?        @map("gross_monthly_salary") @db.Decimal(14, 2)
  netMonthlyTakeHomePay        Decimal?        @map("net_monthly_take_home_pay") @db.Decimal(14, 2)
  bankBranch                   String?         @map("bank_branch") @db.VarChar(120)
  accountNumber                String?         @map("account_number") @db.VarChar(80)
  notes                        String?         @db.Text
  pensionType                  String?         @map("pension_type") @db.VarChar(100)
  pensionSssGsisNo             String?         @map("pension_sss_gsis_no") @db.VarChar(80)
  pensionMonthlyAmount         Decimal?        @map("pension_monthly_amount") @db.Decimal(14, 2)
  pensionStartDate             DateTime?       @map("pension_start_date") @db.Date
  pensionBankBranch            String?         @map("pension_bank_branch") @db.VarChar(120)
  pensionAccountNumber         String?         @map("pension_account_number") @db.VarChar(80)
  pensionDeceasedMember        String?         @map("pension_deceased_member") @db.VarChar(160)
  deceasedMemberSssGsisNo      String?         @map("deceased_member_sss_gsis_no") @db.VarChar(80)
  deceasedMemberMonthlyPension Decimal?        @map("deceased_member_monthly_pension") @db.Decimal(14, 2)
  deceasedMemberPensionStart   DateTime?       @map("deceased_member_pension_start") @db.Date
  deceasedMemberBankBranch     String?         @map("deceased_member_bank_branch") @db.VarChar(120)
  deceasedMemberAccountNumber  String?         @map("deceased_member_account_number") @db.VarChar(80)
  pensionRelationshipTo        String?         @map("pension_relationship_to") @db.VarChar(80)
  pensionProofOfRelationship   String?         @map("pension_proof_of_relationship") @db.Text
  pensionSurvivorId            String?         @map("pension_survivor_id") @db.VarChar(120)
  pensionTotalYearsWeService   Decimal?        @map("pension_total_years_we_service") @db.Decimal(5, 2)
  pensionLiveInPartner         String?         @map("pension_live_in_partner") @db.VarChar(40)
  pensionHealthRiskAssessment  String?         @map("pension_health_risk_assessment") @db.Text
  pensionNotes                 String?         @map("pension_notes") @db.Text
  ofwStatus                    String?         @map("ofw_status") @db.VarChar(80)
  countryOfDeployment          String?         @map("country_of_deployment") @db.VarChar(120)
  ofwCompanyName               String?         @map("ofw_company_name") @db.VarChar(160)
  ofwRecruitmentAgency         String?         @map("ofw_recruitment_agency") @db.VarChar(160)
  ofwAgencyAddress             String?         @map("ofw_agency_address") @db.Text
  ofwDmwiLicense               String?         @map("ofw_dmwi_license") @db.VarChar(120)
  ofwTotalYears                Decimal?        @map("ofw_total_years") @db.Decimal(5, 2)
  owwaMembership               String?         @map("owwa_membership") @db.VarChar(40)
  owwaNo                       String?         @map("owwa_no") @db.VarChar(80)
  ofwSssStatus                 String?         @map("ofw_sss_status") @db.VarChar(40)
  ofwPagibigStatus             String?         @map("ofw_pagibig_status") @db.VarChar(40)
  ofwPhilhealthStatus          String?         @map("ofw_philhealth_status") @db.VarChar(40)
  ofwName                      String?         @map("ofw_name") @db.VarChar(160)
  ofwAuthorizedRepresentative  String?         @map("ofw_authorized_representative") @db.VarChar(160)
  ofwRepRelationship           String?         @map("ofw_rep_relationship") @db.VarChar(120)
  ofwRepCompleteAddress        String?         @map("ofw_rep_complete_address") @db.Text
  ofwEmail                     String?         @map("ofw_email") @db.VarChar(160)
  ofwAlternateEmail            String?         @map("ofw_alternate_email") @db.VarChar(160)
  ofwGcashNumber               String?         @map("ofw_gcash_number") @db.VarChar(40)
  ofwFacebook                  String?         @map("ofw_facebook") @db.VarChar(160)
  ofwBankBranch                String?         @map("ofw_bank_branch") @db.VarChar(120)
  ofwAccountNumber             String?         @map("ofw_account_number") @db.VarChar(80)
  natureOfWork                 String?         @map("nature_of_work") @db.VarChar(160)
  hiringType                   String?         @map("hiring_type") @db.VarChar(80)
  jobTitle                     String?         @map("job_title") @db.VarChar(120)
  industry                     String?         @db.VarChar(120)
  contractStartDate            DateTime?       @map("contract_start_date")
  contractEndDate              DateTime?       @map("contract_end_date")
  monthlySalaryForeign         Decimal?        @map("monthly_salary_foreign") @db.Decimal(14, 2)
  monthlySalaryPhp             Decimal?        @map("monthly_salary_php") @db.Decimal(14, 2)
  remittanceFrequency          String?         @map("remittance_frequency") @db.VarChar(80)
  businessName                 String?         @map("business_name") @db.VarChar(160)
  businessAddress              String?         @map("business_address") @db.Text
  businessRegistrationNo       String?         @map("business_registration_no") @db.VarChar(120)
  businessBankBranch           String?         @map("business_bank_branch") @db.VarChar(120)
  businessAccountNumber        String?         @map("business_account_number") @db.VarChar(80)
  businessDepositorSince       String?         @map("business_depositor_since") @db.VarChar(80)
  businessAccountType          String?         @map("business_account_type") @db.VarChar(80)
  natureOfBusiness             String?         @map("nature_of_business") @db.VarChar(160)
  yearsOfOperations            Decimal?        @map("years_of_operations") @db.Decimal(5, 2)
