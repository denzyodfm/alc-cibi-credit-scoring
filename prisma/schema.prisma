  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@unique([loanApplicationId, sectionKey])
  @@index([loanApplicationId])
  @@map("loan_section_remarks")
}

model LoanComputation {
  id                  Int             @id @default(autoincrement())
  loanApplicationId   Int             @unique @map("loan_application_id")
  outstandingBalance  Decimal?        @map("outstanding_balance") @db.Decimal(14, 2)
  recommendedAmount   Decimal?        @map("recommended_amount") @db.Decimal(14, 2)
  interestRate        Decimal?        @map("interest_rate") @db.Decimal(7, 3)
  serviceFee          Decimal?        @map("service_fee") @db.Decimal(14, 2)
  insurance           Decimal?        @db.Decimal(14, 2)
  documentaryStamp    Decimal?        @map("documentary_stamp") @db.Decimal(14, 2)
  notarialFee         Decimal?        @map("notarial_fee") @db.Decimal(14, 2)
  otherCharges        Decimal?        @map("other_charges") @db.Decimal(14, 2)
  netProceeds         Decimal?        @map("net_proceeds") @db.Decimal(14, 2)
  monthlyAmortization Decimal?        @map("monthly_amortization") @db.Decimal(14, 2)
  collectionType      String?         @map("collection_type") @db.VarChar(80)
  loanType            String?         @map("loan_type") @db.VarChar(80)
  sourceOfRepayment   String?         @map("source_of_repayment") @db.VarChar(160)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  loanApplication     LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@map("loan_computations")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(120)
  entityId   String   @map("entity_id") @db.VarChar(80)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.VarChar(80)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}
