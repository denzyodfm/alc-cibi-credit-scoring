model ScorecardSetting {
  id            Int      @id @default(autoincrement())
  category      String   @unique @db.VarChar(40)
  weightPercent Decimal  @map("weight_percent") @db.Decimal(6, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("scorecard_settings")
}

model ScorecardCriterion {
  id                Int         @id @default(autoincrement())
  category          String      @db.VarChar(40)
  code              String      @unique @db.VarChar(10)
  name              String      @db.VarChar(160)
  questionGuide     String      @map("question_guide") @db.Text
  scoreDescriptions Json        @map("score_descriptions")
  naTreatment       NaTreatment @map("na_treatment")
  autoDqIfZero      Boolean     @default(false) @map("auto_dq_if_zero")
  sortOrder         Int         @map("sort_order")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([category])
  @@map("scorecard_criteria")
}

model CreditScorecard {
  id                  Int                   @id @default(autoincrement())
  loanApplicationId   Int                   @unique @map("loan_application_id")
  characterScore      Decimal               @default(0) @map("character_score") @db.Decimal(6, 2)
  capacityScore       Decimal               @default(0) @map("capacity_score") @db.Decimal(6, 2)
  capitalScore        Decimal               @default(0) @map("capital_score") @db.Decimal(6, 2)
  collateralScore     Decimal               @default(0) @map("collateral_score") @db.Decimal(6, 2)
  conditionsScore     Decimal               @default(0) @map("conditions_score") @db.Decimal(6, 2)
  overallScore        Decimal               @default(0) @map("overall_score") @db.Decimal(6, 2)
  result              ScorecardResult
  autoDqTriggered     Boolean               @default(false) @map("auto_dq_triggered")
  autoDqReason        String?               @map("auto_dq_reason") @db.Text
  recommendationNotes String?               @map("recommendation_notes") @db.Text
  scoredBy            Int?                  @map("scored_by")
  scoredAt            DateTime?             @map("scored_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  loanApplication     LoanApplication       @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  scorer              User?                 @relation("ScorecardScorer", fields: [scoredBy], references: [id])
  items               CreditScorecardItem[]

  @@index([loanApplicationId])
  @@map("credit_scorecards")
}

model CreditScorecardItem {
  id               Int             @id @default(autoincrement())
  scorecardId      Int             @map("scorecard_id")
  category         String          @db.VarChar(40)
  subCriterionCode String          @map("sub_criterion_code") @db.VarChar(10)
  subCriterionName String          @map("sub_criterion_name") @db.VarChar(160)
  score            Int
  isNa             Boolean         @default(false) @map("is_na")
  naTreatment      NaTreatment     @map("na_treatment")
  weightedIncluded Boolean         @default(true) @map("weighted_included")
  autoDqIfZero     Boolean         @default(false) @map("auto_dq_if_zero")
  remarks          String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  scorecard        CreditScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@index([scorecardId])
  @@map("credit_scorecard_items")
}

model CreditCommittee {
  id                    Int                     @id @default(autoincrement())
  committeeName         String                  @map("committee_name") @db.VarChar(160)
  branchId              Int?                    @map("branch_id")
  isHeadOfficeCommittee Boolean                 @default(false) @map("is_head_office_committee")
  minLoanAmount         Decimal                 @map("min_loan_amount") @db.Decimal(14, 2)
  maxLoanAmount         Decimal?                @map("max_loan_amount") @db.Decimal(14, 2)
  status                CommitteeStatus         @default(ACTIVE)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  branch                Branch?                 @relation(fields: [branchId], references: [id])
  members               CreditCommitteeMember[]
  reviews               CreditCommitteeReview[]

  @@index([branchId])
  @@map("credit_committees")
}

model BranchCommitteeAssignment {
  id        Int      @id @default(autoincrement())
  branchId  Int      @map("branch_id")
  roleKey   String   @map("role_key") @db.VarChar(50)
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([branchId, roleKey])
  @@index([userId])
  @@map("branch_committee_assignments")
}

model CreditCommitteeMember {
  id                Int             @id @default(autoincrement())
  creditCommitteeId Int             @map("credit_committee_id")
  userId            Int             @map("user_id")
  committeeRole     String          @map("committee_role") @db.VarChar(80)
  approvalSequence  Int             @default(1) @map("approval_sequence")
  isRequired        Boolean         @default(true) @map("is_required")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  creditCommittee   CreditCommittee @relation(fields: [creditCommitteeId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id])

  @@index([creditCommitteeId])
  @@index([userId])
  @@map("credit_committee_members")
}

model CreditCommitteeReview {
  id                Int               @id @default(autoincrement())
  loanApplicationId Int               @map("loan_application_id")
  creditCommitteeId Int               @map("credit_committee_id")
  reviewerId        Int               @map("reviewer_id")
  committeeRole     String?           @map("committee_role") @db.VarChar(80)
  approvalSequence  Int               @default(1) @map("approval_sequence")
  decision          CommitteeDecision @default(PENDING)
  remarks           String?           @db.Text
  approvalCode      String?           @map("approval_code") @db.VarChar(40)
  recommendedAmount Decimal?          @map("recommended_amount") @db.Decimal(14, 2)
  recommendedTerms  Int?              @map("recommended_terms")
  reviewedAt        DateTime?         @map("reviewed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  loanApplication   LoanApplication   @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  creditCommittee   CreditCommittee   @relation(fields: [creditCommitteeId], references: [id])
  reviewer          User              @relation(fields: [reviewerId], references: [id])

  @@index([loanApplicationId])
  @@index([creditCommitteeId])
  @@index([reviewerId])
  @@map("credit_committee_reviews")
}

model LoanRequirement {
  id                Int             @id @default(autoincrement())
  loanApplicationId Int             @map("loan_application_id")
  requirementType   String          @map("requirement_type") @db.VarChar(80)
  label             String          @db.VarChar(160)
  status            String          @default("PENDING") @db.VarChar(30)
