  serviceProduct    String?         @map("service_product") @db.VarChar(160)
  contactInfo       String?         @map("contact_info") @db.VarChar(160)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@index([loanApplicationId])
  @@map("business_contacts")
}

