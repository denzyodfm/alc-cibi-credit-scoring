  distanceFromResidence        String?         @map("distance_from_residence") @db.VarChar(120)
  rsbsaRegistered              String?         @map("rsbsa_registered") @db.VarChar(80)
  leaseDuration                String?         @map("lease_duration") @db.VarChar(120)
  plantingArrangement          String?         @map("planting_arrangement") @db.Text
  sharingArrangement           String?         @map("sharing_arrangement") @db.Text
  rentAmount                   Decimal?        @map("rent_amount") @db.Decimal(14, 2)
  waterReliability             String?         @map("water_reliability") @db.VarChar(40)
  accessibility                String?         @db.VarChar(40)
  landOwner                    String?         @map("land_owner") @db.VarChar(160)
  landOwnerAddress             String?         @map("land_owner_address") @db.Text
  landTitleNo                  String?         @map("land_title_no") @db.VarChar(120)
  landTaxDeclaration           String?         @map("land_tax_declaration") @db.VarChar(120)
  landTypeOfTitle              String?         @map("land_type_of_title") @db.VarChar(120)
  landTinNo                    String?         @map("land_tin_no") @db.VarChar(80)
  landCharacteristics          String?         @map("land_characteristics") @db.Text
  farmRiskAssessment           String?         @map("farm_risk_assessment") @db.Text
  buyerName                    String?         @map("buyer_name") @db.VarChar(160)
  buyerAddress                 String?         @map("buyer_address") @db.Text
  buyerContactInfo             String?         @map("buyer_contact_info") @db.VarChar(120)
  mainProduct                  String?         @map("main_product") @db.VarChar(120)
  farmerType                   String?         @map("farmer_type") @db.VarChar(80)
  farmLocation                 String?         @map("farm_location") @db.VarChar(180)
  yearsOfExperience            Decimal?        @map("years_of_experience") @db.Decimal(5, 2)
  areaCultivated               String?         @map("area_cultivated") @db.VarChar(120)
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")
  loanApplication              LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@index([loanApplicationId])
  @@map("income_profiles")
}

model ExistingLiability {
  id                 Int             @id @default(autoincrement())
  loanApplicationId  Int             @map("loan_application_id")
  creditor           String          @db.VarChar(160)
  purpose            String?         @db.VarChar(160)
  originalAmount     Decimal?        @map("original_amount") @db.Decimal(14, 2)
  outstandingBalance Decimal?        @map("outstanding_balance") @db.Decimal(14, 2)
  monthlyObligation  Decimal?        @map("monthly_obligation") @db.Decimal(14, 2)
  dueDate            DateTime?       @map("due_date")
  loanStatus         String?         @map("loan_status") @db.VarChar(80)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  loanApplication    LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@index([loanApplicationId])
  @@map("existing_liabilities")
}

model CharacterReference {
  id                Int             @id @default(autoincrement())
  loanApplicationId Int             @map("loan_application_id")
  referenceName     String          @map("reference_name") @db.VarChar(160)
  relationship      String?         @db.VarChar(100)
  contactNo         String?         @map("contact_no") @db.VarChar(60)
  keyFeedback       String?         @map("key_feedback") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@index([loanApplicationId])
  @@map("character_references")
}

model Asset {
  id                Int             @id @default(autoincrement())
  loanApplicationId Int             @map("loan_application_id")
  assetType         String          @map("asset_type") @db.VarChar(80)
  description       String?         @db.Text
  conditionStatus   String?         @map("condition_status") @db.VarChar(80)
  estimatedValue    Decimal?        @map("estimated_value") @db.Decimal(14, 2)
  ownedBy           String?         @map("owned_by") @db.VarChar(160)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@index([loanApplicationId])
  @@map("assets")
}

model Collateral {
  id                 Int             @id @default(autoincrement())
  loanApplicationId  Int             @map("loan_application_id")
  collateralType     String?         @map("collateral_type") @db.VarChar(100)
  registeredOwner    String?         @map("registered_owner") @db.VarChar(160)
  titleNo            String?         @map("title_no") @db.VarChar(120)
  taxDeclarationNo   String?         @map("tax_declaration_no") @db.VarChar(120)
  location           String?         @db.Text
  area               String?         @db.VarChar(120)
  declaredValue      Decimal?        @map("declared_value") @db.Decimal(14, 2)
  assessedValue      Decimal?        @map("assessed_value") @db.Decimal(14, 2)
  marketValue        Decimal?        @map("market_value") @db.Decimal(14, 2)
  appraisedValue     Decimal?        @map("appraised_value") @db.Decimal(14, 2)
  dateLastAppraised  DateTime?       @map("date_last_appraised")
  landClassification String?         @map("land_classification") @db.VarChar(120)
  vehicleCrNo        String?         @map("vehicle_cr_no") @db.VarChar(120)
  vehicleOrNo        String?         @map("vehicle_or_no") @db.VarChar(120)
  vehicleModel       String?         @map("vehicle_model") @db.VarChar(120)
  vehicleMake        String?         @map("vehicle_make") @db.VarChar(120)
  vehicleColor       String?         @map("vehicle_color") @db.VarChar(80)
  vehicleType        String?         @map("vehicle_type") @db.VarChar(80)
  chassisNo          String?         @map("chassis_no") @db.VarChar(120)
  engineNo           String?         @map("engine_no") @db.VarChar(120)
  dateAcquired       DateTime?       @map("date_acquired") @db.Date
  expiryDate         DateTime?       @map("expiry_date")
  notes              String?         @db.Text
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  loanApplication    LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@index([loanApplicationId])
  @@map("collateral")
}

